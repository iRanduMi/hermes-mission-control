# Mission Control V2 Configuration
# Copy this file to .env and fill in your values

# API Keys for programmatic access
# Comma-separated list of valid API keys (for server-side validation)
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
MISSION_CONTROL_API_KEYS=***

# Single API key for client scripts (convenience - pick one from the list above)
# Used by mission_control_client.py when making requests
MISSION_CONTROL_API_KEY=***

# API URL for client scripts
MISSION_CONTROL_API_URL=http://localhost:8000
